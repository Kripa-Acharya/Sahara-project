# साहारा environment configuration — safe placeholders only.
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection (app runtime). With docker-compose: port 5432.
# With the bundled local cluster (npm run db:up): port 5433.
DATABASE_URL="postgresql://sahara:sahara@localhost:5432/sahara"

# Direct (non-pooled) connection used by `prisma migrate`. Same as
# DATABASE_URL unless you use a connection pooler such as PgBouncer.
DIRECT_URL="postgresql://sahara:sahara@localhost:5432/sahara"

# Secret used to sign/derive session material. MUST be long and random in
# production (the app refuses to start otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app — used in emailed verification/reset links.
# Required in production.
APP_URL="http://localhost:3000"

# Optional: comma-separated public hostnames when running behind a reverse
# proxy/CDN, e.g. "app.sahara.example". Used for Server-Action origin checks.
# ALLOWED_ORIGINS=""
